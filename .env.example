# Go Toolchain
# Pin Go version to prevent automatic upgrades from a newer local Go installation
GOTOOLCHAIN=go1.26.5

# Server Configuration
# Port the server will listen on (usually set by hosting platform)
PORT=8080
# Host address to bind to (0.0.0.0 binds to all interfaces)
HOST=0.0.0.0
# Log level for application logs
# Options: debug, info, warn, error
LOG_LEVEL=info
# Client IP strategy. Keep direct unless running behind a trusted X-Forwarded-For proxy.
IP_EXTRACTOR=direct

# Firebase project used by Auth and Firestore
# In development (APP_ENVIRONMENT=development), this can be omitted to use "demo-test-project"
# With that demo project and no emulator hosts, public routes start while protected routes return 503.
# Configure both emulator hosts below to initialize the SDK against the local emulators.
# Outside development, a non-demo project ID is required or the server fails to start.
FIREBASE_PROJECT_ID=demo-test-project
# Application environment label (development, staging, production)
APP_ENVIRONMENT=development

# Firebase Emulators Configuration
# Development only: the application rejects these variables in every other environment.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:7130
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:7110
