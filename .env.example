# Go Toolchain
# Pin Go version to prevent automatic upgrades from a newer local Go installation
GOTOOLCHAIN=go1.26.7

# Server Configuration
# Port the server will listen on (usually set by hosting platform)
PORT=8080
# Host address to bind to (0.0.0.0 binds to all interfaces)
HOST=0.0.0.0
# Log level for application logs
# Options: debug, info, warn, error
LOG_LEVEL=info

# Application environment label (development, staging, production)
APP_ENVIRONMENT=development

# Browser CORS is disabled when empty. Set a comma-separated list of exact HTTP(S) origins.
# Wildcards, paths, queries, fragments, and user information are rejected.
CORS_ALLOWED_ORIGINS=

# Firebase mode: offline, emulator, or live
# offline and emulator are development-only. live requires a non-demo project and ADC.
FIREBASE_MODE=offline
# Firebase project used by Auth and Firestore. Omit outside live mode to use demo-test-project.
FIREBASE_PROJECT_ID=demo-test-project

# Firebase Emulators Configuration
# Set FIREBASE_MODE=emulator and configure both strict host:port values.
# Emulator mode is development-only and requires a demo-* project ID.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:7130
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:7110
